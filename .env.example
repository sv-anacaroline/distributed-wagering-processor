# Docker Compose development environment. Never commit .env.
APP_PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=local_dev_only
SQS_PORT=4566
AWS_REGION=us-east-1

# LocalStack requires LOCALSTACK_AUTH_TOKEN (2026+).
AWS_EMULATOR_IMAGE=localstack/localstack:latest
LOCALSTACK_AUTH_TOKEN=
# Token-free alternative: AWS_EMULATOR_IMAGE=ministackorg/ministack:1.5.40

K6_VUS=5
K6_DURATION=15s

# OIDC auth (the dev-only disable mode is forbidden in NODE_ENV=production).
HTTP_AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
# Set an identical 32+ character secret across replicas in production.
PAGINATION_CURSOR_SECRET=local-only-not-for-production

# SQS worker URLs override GetQueueUrl and are used in AWS/EKS deployment.
# Locally the workers resolve queues by name using MiniStack/LocalStack.
# SQS_WAGER_TRANSACTIONS_URL=
# SQS_WAGER_TRANSACTIONS_DLQ_URL=
# SQS_WAGER_EVENTS_URL=
# EVENTS_E2E=1 (requires a running emulator and a migrated PostgreSQL)
