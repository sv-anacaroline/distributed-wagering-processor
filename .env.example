# Docker Compose development environment. Never commit .env.
APP_PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=local_dev_only
SQS_PORT=4566
AWS_REGION=us-east-1

# LocalStack requires LOCALSTACK_AUTH_TOKEN (2026+).
AWS_EMULATOR_IMAGE=localstack/localstack:latest
LOCALSTACK_AUTH_TOKEN=
# Token-free alternative: AWS_EMULATOR_IMAGE=ministackorg/ministack:1.5.40

K6_VUS=5
K6_DURATION=15s

# OIDC auth (the dev-only disable mode is forbidden in NODE_ENV=production).
HTTP_AUTH_MODE=oidc
# Issuer must match the signed token exactly (host's Keycloak URL).
OIDC_ISSUER=http://localhost:8080/realms/wagering
# If Bun runs directly on the host: use localhost:8080, not keycloak:8080.
# Docker Compose injects the internal service address automatically.
OIDC_JWKS_URL=
OIDC_AUDIENCE=wagering-api
OIDC_METRICS_CLIENT_ID=wagering-monitor

# Local development/demo only. Never use these credentials in production.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=dev-admin-change-me
KEYCLOAK_PROVIDER_A_SECRET=local-provider-a-change-me
KEYCLOAK_PROVIDER_B_SECRET=local-provider-b-change-me
KEYCLOAK_MONITOR_SECRET=local-monitor-change-me
KEYCLOAK_BASE_URL=http://localhost:8080
AUTH_API_BASE_URL=http://127.0.0.1:3000
# Set an identical 32+ character secret across replicas in production.
PAGINATION_CURSOR_SECRET=local-only-not-for-production

# SQS worker URLs override GetQueueUrl and are used in AWS/EKS deployment.
# Locally the workers resolve queues by name using MiniStack/LocalStack.
# SQS_WAGER_TRANSACTIONS_URL=
# SQS_WAGER_TRANSACTIONS_DLQ_URL=
# SQS_WAGER_EVENTS_URL=
# EVENTS_E2E=1 (requires a running emulator and a migrated PostgreSQL)
