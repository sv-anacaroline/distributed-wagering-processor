{
  "id": null,
  "uid": "wagering-observability",
  "title": "Wagering Processor · Visão completa",
  "description": "HTTP, PostgreSQL, SQS, Outbox, ledger, traces, logs e métricas OTLP",
  "tags": [
    "wagering",
    "otel",
    "financial",
    "sqs",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Investigar todos os logs",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?left=%7B%22datasource%22%3A%22loki%22%7D"
    },
    {
      "title": "Explorar traces",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%7D"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Requisições HTTP / s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"wager_http_requests_total.*\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Erros HTTP / s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
